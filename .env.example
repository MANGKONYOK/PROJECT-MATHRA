# PROJECT MATHRA - ENVIRONMENT CONFIGURATION

# Server Settings - Gateway Server of FastAPI Security Gateway Proxy
PROXY_HOST=0.0.0.0                   # Recieve all connection
PROXY_PORT=8000                      # FastAPI Proxy Gateway
LOG_LEVEL=INFO                       # Show Log
ENVIRONMENT=development              # Development, Testing, Production

# Database Settings - Telemetry & Threat Logs
# Local default: SQLite with aiosqlite
DATABASE_URL=sqlite+aiosqlite:///./backend/data/mathra_events.db
# Production example: postgresql+asyncpg://user:pass@host:8888/mathra

# Model Providers - Upstream LLM Services
OPENAI_API_KEY=sk-demo-mock-key-for-testing
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=gpt-4o-mini
FALLBACK_LOCAL_MODEL=ollama/llama3

# Security & Feature Flags - Pipeline Control
ENABLE_PII_REDACTION=true           # PII/PHI check by Microsoft Presidio and Regex Masking
ENABLE_SECRET_SCANNING=true         # Credentials (API Keys, Token, Private Keys) 
ENABLE_GUARDRAILS=true              # Prompt Injection & Jailbreak Protection
SIMULATION_MODE=true                # Simulate Mock Test

# Red Team Engine - Pentest Runner
REDTEAM_CONCURRENCY=10              # Thread of Test concurrently
REDTEAM_TARGET_URL=http://localhost:8000/v1/chat/completions   # Endpoint to send payload for test

# Overwatch Proxy - Network Interceptor
OVERWATCH_LISTEN_PORT=8080          # Intercept HTTP Traffic from all device on network (8080 is not using by others)